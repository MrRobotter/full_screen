<view wx:if="{{!fullScreen}}">
  <view class="form-wrap">
    <textarea placeholder="输入字幕文字" bindinput="onTextInput" value="{{text}}" class="input-area"></textarea>

    <view class="item">
      <text>字体大小：{{fontSize}}px</text>
      <slider min="24" max="120" value="{{fontSize}}" bindchange="onFontSizeChange"></slider>
    </view>
    <view class="item">
      <text>滚动速度：{{speed}}</text>
      <slider min="1" max="10" value="{{speed}}" bindchange="onSpeedChange"></slider>
    </view>
    <view class="item">
      <text>文字颜色</text>
      <picker bindchange="onColorChange" value="{{colorIndex}}">
        <view class="color-box" style="background:{{colorList[colorIndex]}}"></view>
      </picker>
    </view>

    <button bindtap="enterFull" type="primary">进入横屏字幕</button>
    <button bindtap="clearText">清空文字</button>
  </view>
</view>

<!-- 横屏全屏滚动字幕区域 -->
<view wx:else class="full-wrap" bindtap="exitFull">
  <view class="scroll-text" style="font-size:{{fontSize}}px;color:{{colorList[colorIndex]}};animation-duration:{{speedNum}}s">
    {{text}}
  </view>
</view>
