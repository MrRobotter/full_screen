.form-wrap{
  padding:30rpx;
}
.input-area{
  background:#fff;
  min-height:200rpx;
  padding:20rpx;
  border-radius:12rpx;
  margin-bottom:30rpx;
}
.item{
  color:#fff;
  margin-bottom:30rpx;
}
.color-box{
  width:80rpx;
  height:80rpx;
  border-radius:50%;
  margin-top:10rpx;
}
button{
  margin:20rpx 0;
}

/* 全屏横屏样式 */
.full-wrap{
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:#000;
  display:flex;
  align-items:center;
  overflow:hidden;
  width:100vw;
  height:100vh;
}
.scroll-text{
  white-space: nowrap;
  animation: scroll linear infinite;
}
@keyframes scroll{
  from{transform: translateX(100vw);}
  to{transform: translateX(-100%);}
}
